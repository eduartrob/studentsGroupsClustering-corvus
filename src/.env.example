# =========================================================================
# CONFIGURACIÓN DEL SERVIDOR FASTAPI (EQUIPOS)
# =========================================================================

# URL de conexión a la base de datos PostgreSQL local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corvus_db

# Secreto para firmar y verificar tokens JWT (Debe coincidir con tu backend de auth)
JWT_SECRET=super_secret_corvus_dev_key
JWT_ALGORITHM=HS256

# Bypass de autenticación para desarrollo local (permite testing rápido en Swagger UI)
# Si está en 'true', puedes pasar directamente el UUID del usuario como Bearer token
DEV_BYPASS=true
